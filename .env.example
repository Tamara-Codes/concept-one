# Local app URL used for auth redirects during development.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Neon Postgres and Neon Auth (fill from the v2 branch after setup).
DATABASE_URL=postgresql://...
NEON_AUTH_BASE_URL=https://...
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_NEON_AUTH_URL=https://...

# Cloudflare R2 private bucket for offer images.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=concept-one-offers
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Exact addresses allowed to sign in, comma-separated.
ALLOWED_OFFER_EMAILS=ivica@conceptone.hr,sasa@conceptone.hr,codewithtamara@gmail.com
